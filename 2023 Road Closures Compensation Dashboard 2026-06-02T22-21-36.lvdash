{
  "datasets": [
    {
      "name": "gold_annual",
      "displayName": "Annual Compensation by Business",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  workspace.default.road_comp_gold_annual_compensation"
      ]
    },
    {
      "name": "gold_daily",
      "displayName": "Street Compensation Summary",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  workspace.default.road_comp_gold_street_compensation"
      ]
    }
  ],
  "pages": [
    {
      "name": "68473727",
      "displayName": "Page 1",
      "layout": [
        {
          "widget": {
            "name": "total_compensation",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "gold_annual",
                  "fields": [
                    {
                      "name": "sum(annual_compensation_ils)",
                      "expression": "SUM(`annual_compensation_ils`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "frame": {
                "title": "Total Compensation 2023",
                "showTitle": true
              },
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "sum(annual_compensation_ils)",
                  "format": {
                    "type": "number-currency",
                    "currencyCode": "ILS",
                    "abbreviation": "compact",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 0
                    }
                  }
                }
              }
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 3,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "total_businesses",
